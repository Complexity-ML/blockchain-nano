# CMake is already required by every dependency builder; no extra interpreter.
if(NANO_CI_CHECK STREQUAL "pin")
 file(READ "dependencies.lock.json" lock)
 string(JSON expected GET "${lock}" cpp-libp2p commit)
 file(READ "ci-reports/libp2p-revision.txt" actual)
 string(STRIP "${actual}" actual)
 if(NOT actual STREQUAL expected)
  message(FATAL_ERROR "cpp-libp2p revision differs from reviewed lock")
 endif()
elseif(NANO_CI_CHECK STREQUAL "registry")
 set(expected bootstrap json_frame peer_status inbound_budget timed_reply json_stream gossip_progress bft_vote_knowledge altair_stream altair_worker altair_core_dispatch altair_core_recovery altair_base64 altair_block_relay capella_catalog_relay capella_block_delivery core_keepalive supervisor_identity capella_attestation_delivery capella_head_catalog capella_relay_schedule)
 file(READ "ci-reports/network-selection.json" registry)
 string(JSON count LENGTH "${registry}" tests)
 list(LENGTH expected expected_count)
 if(NOT count EQUAL expected_count)
  message(FATAL_ERROR "Network CTest count differs from reviewed registry")
 endif()
 math(EXPR last "${count}-1")
 set(actual)
 foreach(index RANGE 0 ${last})
  string(JSON name GET "${registry}" tests ${index} name)
  list(APPEND actual "${name}")
  string(JSON property_count LENGTH "${registry}" tests ${index} properties)
  if(property_count GREATER 0)
   math(EXPR property_last "${property_count}-1")
   foreach(property_index RANGE 0 ${property_last})
    string(JSON property GET "${registry}" tests ${index} properties ${property_index} name)
    if(property STREQUAL "DISABLED" OR property STREQUAL "SKIP_RETURN_CODE" OR property STREQUAL "SKIP_REGULAR_EXPRESSION")
     message(FATAL_ERROR "Network CTest skip property is forbidden: ${name}/${property}")
    endif()
   endforeach()
  endif()
 endforeach()
 list(SORT expected)
 list(SORT actual)
 if(NOT actual STREQUAL expected)
  message(FATAL_ERROR "Network CTest names differ from reviewed registry")
 endif()
 message(STATUS "Verified ${count} network CTest registrations")
else()
 message(FATAL_ERROR "Unknown network verification mode")
endif()
