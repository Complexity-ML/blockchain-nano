+ // Only this idempotent operation may be retried; never retry delivery or open.
+ // A missing transport response remains bounded by the overall deadline.
+ void close_attempt(bool retry){
+  call("nano_capellaCatalogClose",Json::array({token_,handle_}),callback([retry](auto& self,Json value){
+   if(value.is_null()&&retry){self.close_attempt(false);return;}
+   self.complete(self.desired_success_&&value==true,value==true);
+  }));
+ }
@@ -30 +38 @@ private:
-  call("nano_capellaCatalogClose",Json::array({token_,handle_}),callback([](auto& self,Json value){self.complete(self.desired_success_&&value==true,value==true);}));
+  close_attempt(true);
diff --git a/network/capella_inventory_sessions.hpp b/network/capella_inventory_sessions.hpp
index f908cd5..e25a055 100644
--- a/network/capella_inventory_sessions.hpp
+++ b/network/capella_inventory_sessions.hpp
@@ -2,0 +3 @@
+#include <algorithm>
@@ -32 +33,8 @@ public:
- void close(const std::string& owner,const std::string& id){std::lock_guard lock(mutex_);reap(now_());auto it=find(owner,id);bytes_-=it->second.snapshot->root_bytes();entries_.erase(it);}
+ // Closing is idempotent: a lost acknowledgement can be retried without
+ // retaining tombstones or extending leases. A live foreign handle is protected.
+ void close(const std::string& owner,const std::string& id){
+  if(owner.empty()||owner.size()>256||id.size()!=66||!id.starts_with("0x")||!std::all_of(id.begin()+2,id.end(),[](char c){return (c>='0'&&c<='9')||(c>='a'&&c<='f');}))throw std::invalid_argument("Invalid Capella inventory close");
+  std::lock_guard lock(mutex_);reap(now_());auto it=entries_.find(id);if(it==entries_.end())return;
+  if(it->second.owner!=owner)throw std::invalid_argument("Capella inventory handle unavailable");
+  bytes_-=it->second.snapshot->root_bytes();entries_.erase(it);
+ }
