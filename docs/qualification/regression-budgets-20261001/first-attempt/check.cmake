file(READ "/reports/selection.json" selection)
string(JSON count LENGTH "${selection}" tests)
if(NOT count EQUAL 15)
 message(FATAL_ERROR "Expected exactly 15 formerly unbounded tests")
endif()
math(EXPR last "${count}-1")
foreach(index RANGE 0 ${last})
 string(JSON name GET "${selection}" tests ${index} name)
 string(JSON length LENGTH "${selection}" tests ${index} properties)
 set(found FALSE)
 math(EXPR property_last "${length}-1")
 foreach(p RANGE 0 ${property_last})
  string(JSON prop GET "${selection}" tests ${index} properties ${p} name)
  if(prop STREQUAL "TIMEOUT")
   string(JSON timeout GET "${selection}" tests ${index} properties ${p} value)
   if(timeout LESS_EQUAL 0)
    message(FATAL_ERROR "Invalid timeout")
   endif()
   set(found TRUE)
  endif()
  if(prop STREQUAL "DISABLED" OR prop STREQUAL "SKIP_RETURN_CODE" OR prop STREQUAL "SKIP_REGULAR_EXPRESSION")
   message(FATAL_ERROR "Skip forbidden")
  endif()
 endforeach()
 if(NOT found)
  message(FATAL_ERROR "Missing explicit timeout: ${name}")
 endif()
endforeach()
