+                        fd = os.open(p, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK)
+                        first_fd = os.fstat(fd)
+                        path_row = p.lstat()
+                        final_fd = os.fstat(fd)
+                        diagnostic['fdNine'] = {k: getattr(first_fd, k) for k in m.F}
+                        diagnostic['pathNine'] = {k: getattr(path_row, k) for k in m.F}
