file(READ "/reports/expected-registry.json" expected)
file(READ "/reports/registry.json" actual)
string(JSON expected_count LENGTH "${expected}" tests)
string(JSON count LENGTH "${actual}" tests)
if(NOT count EQUAL 400 OR NOT count EQUAL expected_count)
 message(FATAL_ERROR "Complete Docker registry must retain all 400 configured names")
endif()
math(EXPR last "${count}-1")
set(expected_names)
set(actual_names)
foreach(i RANGE 0 ${last})
 string(JSON name GET "${actual}" tests ${i} name)
 string(JSON expected_name GET "${expected}" tests ${i} name)
 list(APPEND actual_names "${name}")
 list(APPEND expected_names "${expected_name}")
 string(JSON command GET "${actual}" tests ${i} command 0)
 if(NOT EXISTS "${command}")
  message(FATAL_ERROR "Unbuilt test command: ${name}")
 endif()
 string(JSON n LENGTH "${actual}" tests ${i} properties)
 math(EXPR prop_last "${n}-1")
 set(timed FALSE)
 foreach(p RANGE 0 ${prop_last})
  string(JSON prop GET "${actual}" tests ${i} properties ${p} name)
  if(prop STREQUAL "TIMEOUT")
   string(JSON budget GET "${actual}" tests ${i} properties ${p} value)
   if(budget LESS_EQUAL 0)
    message(FATAL_ERROR "Invalid timeout: ${name}")
   endif()
   set(timed TRUE)
  endif()
  if(prop STREQUAL "DISABLED" OR prop STREQUAL "SKIP_RETURN_CODE" OR prop STREQUAL "SKIP_REGULAR_EXPRESSION")
   message(FATAL_ERROR "Skipped test forbidden: ${name}")
  endif()
 endforeach()
 if(NOT timed)
  message(FATAL_ERROR "Unbounded test: ${name}")
 endif()
endforeach()
list(SORT actual_names)
list(SORT expected_names)
if(NOT actual_names STREQUAL expected_names)
 message(FATAL_ERROR "Complete Docker registry names changed")
endif()
list(REMOVE_DUPLICATES actual_names)
list(LENGTH actual_names unique_count)
if(NOT unique_count EQUAL 400)
 message(FATAL_ERROR "Duplicate test name")
endif()
message(STATUS "All 400 complete Docker registrations are present, built, bounded and enabled")
