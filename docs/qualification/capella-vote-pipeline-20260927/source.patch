diff --git a/network/test_capella_catalog_relay.cpp b/network/test_capella_catalog_relay.cpp
index 5069826..c1b8358 100644
--- a/network/test_capella_catalog_relay.cpp
+++ b/network/test_capella_catalog_relay.cpp
@@ -54,0 +55,28 @@ int main(){try{
+ // Two votes may be in flight; reversed ACKs must not advance the page early.
+ for(const std::string mode:{"reorder","reject","cancel"}){
+  asio::io_context io;InboundBudget budget;auto ingress=std::make_shared<AltairMessageIngress>(profile,budget);
+  std::vector<Reply> acks;unsigned pages=0,closed=0,done=0;Json result;
+  auto core=[&](std::string method,Json args,Reply cb){
+   if(method=="nano_capellaCatalogGeneration")cb(root('e'));
+   else if(method=="nano_capellaCatalogAcquire")cb(Json{{"handle",root('c')}});
+   else if(method=="nano_capellaCatalogRelease"){++closed;cb(true);}
+   else if(method=="nano_capellaCatalogPage"){
+    ++pages;check(pages==1||args[2]==root('3'),"parallel page skipped unacknowledged cursor");
+    cb(Json{{"kind","attestation"},{"sequence","0x1"},{"digest",root('d')},{"entries",pages==1?Json::array({root('1'),root('2'),root('3')}):Json::array({root('4')})},{"next",pages==1?Json(root('3')):Json(nullptr)}});
+   }else if(method=="nano_capellaExport")cb(Json{{"available",true},{"root",args[2]},{"envelope",{{"chainId",profile.chain_id},{"genesisHash",profile.genesis_hash},{"forkDigest",profile.fork_digest},{"consensusIdentity",profile.consensus_identity},{"kind","attestation"},{"ssz","0x0102"}}}});
+   else throw std::runtime_error("unexpected pipeline RPC");
+  };
+  auto relay=std::make_shared<CapellaCatalogRelay>(io,core,[&](auto,auto,Reply cb){acks.push_back(cb);},"token","attestation",ingress,3,4,[&](Json j){++done;result=j;},CapellaCatalogRelay::Known{},2);
+  auto drain=[&]{io.restart();io.poll();};relay->start(1s);drain();check(acks.size()==2&&pages==1&&done==0,"pipeline not bounded at two pending ACKs");
+  if(mode=="reorder"){
+   acks[1](Json{{"accepted",true}});drain();check(acks.size()==3&&pages==1,"out of order ACK advanced page");
+   acks[2](Json{{"accepted",true}});drain();check(pages==1&&done==0,"unacknowledged first message skipped");
+   acks[0](Json{{"accepted",true}});drain();check(pages==2&&acks.size()==4,"next page did not follow complete ACK set");
+   acks[3](Json{{"accepted",true}});acks[3](Json{{"accepted",true}});drain();check(done==1&&closed==1&&result["success"]==true&&result["delivered"]==4,"parallel success or duplicate ACK handling failed");
+  }else{
+   if(mode=="cancel")relay->cancel();else acks[1](Json{{"accepted",false}});drain();
+   acks[0](Json{{"accepted",true}});acks[1](Json{{"accepted",true}});drain();
+   check(done==1&&closed==1&&result["success"]==false&&acks.size()==2&&pages==1,"late ACK resurrected failed pipeline");
+  }
+  ++scenarios;
+ }
