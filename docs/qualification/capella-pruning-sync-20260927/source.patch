+#pragma once
+#ifdef NANO_SYNC_FAULT
+static int pruning_sync_writer(const fs::path& directory){
+ const auto bundle=load(directory/"bundle.json");const auto profile=bundle.at("profile").get<std::string>();const auto rules=load_capella_fork_profile(profile,sha256(Bytes(profile.begin(),profile.end())),1024*1024);
+ Genesis g;g.chain_id=rules.transition.chain_id;g.consensus="beacon";g.evm_revision=EvmRevision::Shanghai;g.block=Block::from_json(bundle.at("genesis"));g.state=State::from_json(bundle.at("alloc"));
+ ChainStore witness(directory/"witness");Blockchain owner(directory/"db",g);CapellaDurableReactor reactor(owner,rules,crash_limits,witness);const auto before=reactor.current();const auto& disk=owner.store();const auto old=disk.fork_checkpoint(g.chain_id,g.block.header.hash(),crash_limits.envelope_bytes,before.token);
+ const auto pruned=prepare_capella_pruned_store(*before.state,before.state->timed.view.finalized.root,rules);const auto inner=capella_store_snapshot(pruned,rules,crash_limits);auto next=Json::parse(old->snapshot);if(next.contains("store"))next["store"]=Json::parse(inner);else next=Json::parse(inner);
+ save(directory/"expected.json",Json{{"old",old->snapshot},{"new",next.dump()},{"sequence",before.token.sequence},{"oldAnchor",hex(Bytes(before.state->timed.view.anchor.begin(),before.state->timed.view.anchor.end()))},{"newAnchor",hex(Bytes(pruned.timed.view.anchor.begin(),pruned.timed.view.anchor.end()))}});
+ const bool fault_witness=bundle.at("faultWitness");fs::path wal;for(const auto& entry:fs::directory_iterator(directory/(fault_witness?"witness":"db")))if(entry.path().extension()==".log"&&(wal.empty()||entry.path().filename()>wal.filename()))wal=entry.path();check(!wal.empty(),"pruning sync WAL missing");const auto offset=fs::file_size(wal);
+ Rpc rpc(owner);nano_test_arm_sync_fault(wal.c_str());bool failed=false;try{reactor.prune_finalized();}catch(const std::runtime_error&){failed=true;}check(failed&&nano_test_sync_failures()>0,"pruning sync fault not reached");
+ unsigned blocked=0;auto refuse=[&](auto action){try{action();}catch(const std::runtime_error&){++blocked;}};refuse([&]{reactor.current();});refuse([&]{reactor.prune_finalized();});refuse([&]{reactor.tick(before.state->timed.clock.time_ms);});refuse([&]{disk.latest();});refuse([&]{disk.fork_checkpoint(g.chain_id,g.block.header.hash(),crash_limits.envelope_bytes);});refuse([&]{owner.tip();});refuse([&]{owner.state();});refuse([&]{owner.finalized_block();});check(blocked==(fault_witness?6:8),"uncertain pruning left owner accessible");check(rpc.handle(Json{{"jsonrpc","2.0"},{"id",1},{"method","eth_blockNumber"},{"params",Json::array()}}).contains("error"),"uncertain pruning served RPC");
+ std::cout<<Json{{"wal",wal.filename().string()},{"before",offset},{"after",fs::file_size(wal)},{"blocked",blocked}}.dump()<<std::endl;_exit(0);
+}
+static void qualify_pruning_sync(const CapellaForkStore& initial,const CapellaSignedVotes& votes,const CapellaForkBlockRules& rules,const Genesis& genesis){
+ const auto& head=capella_fork_head(initial,rules);
+ for(unsigned disposition=0;disposition<4;++disposition){const bool fault_witness=disposition>=2,lose=disposition%2;Temp directory;
+  {ChainStore disk(directory/"db");disk.bind_chain(genesis.chain_id,genesis.block.header.hash(),genesis.consensus,genesis.staking_contract);disk.commit(genesis.block,genesis.state,{});std::map<Int,const CapellaForkBlock*> ordered;for(const auto& [id,record]:initial.blocks)ordered.emplace(record.execution_block.header.number,&record);for(const auto& [height,record]:ordered)disk.commit(record->execution_block,record->execution_state,record->receipts);}
+  {ChainStore witness(directory/"witness");Blockchain owner(directory/"db",genesis);CapellaDurableReactor reactor(owner,rules,crash_limits,initial,{},&witness);for(const auto& [id,wire]:votes)check(reactor.vote_ssz(wire),"pruning fixture vote restore rejected");}
+  save(directory/"bundle.json",Json{{"profile",capella_fork_profile(rules).dump()},{"genesis",genesis.block.to_json(true)},{"alloc",genesis.state.to_json()},{"faultWitness",fault_witness}});
+  const auto result=success(run({executable,"--pruning-sync-writer",directory.path.string()}));const auto wal=directory/(fault_witness?"witness":"db")/result.at("wal").get<std::string>();check(fs::file_size(wal)==result.at("after").get<uint64_t>()&&result.at("after")>result.at("before"),"pruning sync WAL suffix missing");
+  if(lose){const int fd=open(wal.c_str(),O_WRONLY);check(fd>=0,"open owned pruning WAL");const bool ok=ftruncate(fd,result.at("before").get<uint64_t>())==0&&fsync(fd)==0;close(fd);check(ok,"truncate owned pruning WAL");}
+  const auto expected=load(directory/"expected.json");ChainStore witness(directory/"witness");Blockchain owner(directory/"db",genesis);const auto& disk=owner.store();const auto record=disk.fork_checkpoint(genesis.chain_id,genesis.block.header.hash(),crash_limits.envelope_bytes);const bool primary_new=!fault_witness&&!lose;
+  check(record&&record->snapshot==expected.at(primary_new?"new":"old").get<std::string>()&&record->token.sequence==expected.at("sequence").get<uint64_t>()+unsigned(primary_new),"mixed pruning checkpoint before recovery");
+  auto resumed=std::make_unique<CapellaDurableReactor>(owner,rules,crash_limits,witness);const bool recovered_new=!(fault_witness&&lose);const auto current=resumed->current();check(hex(Bytes(current.state->timed.view.anchor.begin(),current.state->timed.view.anchor.end()))==expected.at(recovered_new?"newAnchor":"oldAnchor").get<std::string>(),"pruning witness recovery chose wrong anchor");check(resumed->signed_votes()==votes&&owner.tip().header.hash()==head.execution_block.header.hash()&&owner.state().root()==head.execution_state.root(),"pruning recovery lost votes or execution state");
+  check(resumed->prune_finalized()==!recovered_new,"pruning recovery retry differs");const auto completed=resumed->current().token;check(completed.sequence==expected.at("sequence").get<uint64_t>()+1&&disk.fork_checkpoint(genesis.chain_id,genesis.block.header.hash(),crash_limits.envelope_bytes,completed)->snapshot==expected.at("new").get<std::string>(),"pruning recovery changed candidate");check(!resumed->prune_finalized()&&resumed->current().token==completed,"duplicate pruning republished");
+  resumed.reset();resumed=std::make_unique<CapellaDurableReactor>(owner,rules,crash_limits,witness);check(resumed->current().token==completed&&resumed->signed_votes()==votes,"recovered pruning not restart-stable");Rpc rpc(owner);check(!rpc.handle(Json{{"jsonrpc","2.0"},{"id",1},{"method","eth_blockNumber"},{"params",Json::array()}}).contains("error"),"recovered pruning RPC unavailable");
+  std::cout<<Json{{"scenario","capella-pruning-sync-recovery"},{"faultWitness",fault_witness},{"lostSuffix",lose},{"blockedOperations",result.at("blocked")},{"recoveredPrunedBeforeRetry",recovered_new},{"signedVotesPreserved",true},{"retryIdempotent",true},{"physicalPowerLoss",false}}.dump()<<std::endl;
+ }
+}
