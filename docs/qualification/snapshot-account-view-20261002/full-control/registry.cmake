file(READ "${REGISTRY}" registry)
string(JSON count LENGTH "${registry}" tests)
if(NOT count EQUAL 427)
 message(FATAL_ERROR "Expected full registry427; found ${count}")
endif()
set(names)
math(EXPR last "${count}-1")
foreach(i RANGE 0 ${last})
 string(JSON name GET "${registry}" tests ${i} name)
 list(FIND names "${name}" found)
 if(NOT found EQUAL -1)
  message(FATAL_ERROR "Duplicate test ${name}")
 endif()
 list(APPEND names "${name}")
 string(JSON n LENGTH "${registry}" tests ${i} properties)
 math(EXPR end "${n}-1")
 set(deadline 0)
 foreach(j RANGE 0 ${end})
  string(JSON property GET "${registry}" tests ${i} properties ${j} name)
  if(property MATCHES "^(DISABLED|SKIP_RETURN_CODE|SKIP_REGULAR_EXPRESSION)$")
   message(FATAL_ERROR "Skip/disabled property in ${name}")
  endif()
  if(property STREQUAL "TIMEOUT")
   string(JSON deadline GET "${registry}" tests ${i} properties ${j} value)
  endif()
 endforeach()
 if(NOT deadline GREATER 0)
  message(FATAL_ERROR "Missing positive deadline for ${name}")
 endif()
endforeach()
