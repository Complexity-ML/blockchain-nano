    "material":{"type":"object","additionalProperties":false,"required":["st_dev","st_ino","st_mode","st_nlink","st_uid","st_gid","st_size","st_mtime_ns","st_ctime_ns","sha256"],"properties":{"st_dev":{"type":"integer"},"st_ino":{"type":"integer"},"st_mode":{"type":"integer"},"st_nlink":{"type":"integer","minimum":1},"st_uid":{"type":"integer"},"st_gid":{"type":"integer"},"st_size":{"type":"integer","minimum":1},"st_mtime_ns":{"type":"integer"},"st_ctime_ns":{"type":"integer"},"sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"}}}
  }
