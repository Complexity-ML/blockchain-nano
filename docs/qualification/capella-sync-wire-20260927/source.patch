diff --git a/include/nano/consensus_sync_message.hpp b/include/nano/consensus_sync_message.hpp
new file mode 100644
index 0000000..2d028e3
--- /dev/null
+++ b/include/nano/consensus_sync_message.hpp
@@ -0,0 +1,10 @@
+#pragma once
+#include "nano/core.hpp"
+#include "nano/consensus_signing.hpp"
+namespace nano {
+struct CapellaSyncMessage {uint64_t slot=0,validator_index=0;ConsensusRoot beacon_block_root{};std::array<uint8_t,96> signature{};};
+// Fixed SSZ SyncCommitteeMessage: slot, block root, validator index, signature.
+// Encoding only; admission checks time, branch, membership and signature.
+Bytes encode_capella_sync_message(const CapellaSyncMessage&);
+std::optional<CapellaSyncMessage> decode_capella_sync_message(std::span<const uint8_t>);
+}
diff --git a/src/consensus_sync_message.cpp b/src/consensus_sync_message.cpp
new file mode 100644
index 0000000..806e0ff
--- /dev/null
+++ b/src/consensus_sync_message.cpp
@@ -0,0 +1,13 @@
+#include "nano/consensus_sync_message.hpp"
+namespace nano {
+Bytes encode_capella_sync_message(const CapellaSyncMessage& message){
+ Bytes out(144);for(unsigned i=0;i<8;++i){out[i]=uint8_t(message.slot>>(8*i));out[40+i]=uint8_t(message.validator_index>>(8*i));}
+ std::copy(message.beacon_block_root.begin(),message.beacon_block_root.end(),out.begin()+8);
+ std::copy(message.signature.begin(),message.signature.end(),out.begin()+48);return out;
+}
+std::optional<CapellaSyncMessage> decode_capella_sync_message(std::span<const uint8_t> bytes){
+ if(bytes.size()!=144)return std::nullopt;CapellaSyncMessage out;
+ for(unsigned i=0;i<8;++i){out.slot|=uint64_t(bytes[i])<<(8*i);out.validator_index|=uint64_t(bytes[40+i])<<(8*i);}
+ std::copy_n(bytes.begin()+8,32,out.beacon_block_root.begin());std::copy_n(bytes.begin()+48,96,out.signature.begin());return out;
+}
+}
