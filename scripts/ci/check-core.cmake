cmake_minimum_required(VERSION 3.20)
# Daily core selection only; this does not qualify the full configured registry.
if(NOT DEFINED REGISTRY)
 message(FATAL_ERROR "REGISTRY required")
endif()
set(expected core chain rpc_queue_expiry rpc_simulation_context rpc rpc_state_block_id rpc_get_proof rpc_state_read_cost ethereum_consensus_bls_verify ethereum_consensus_bls_fast_aggregate storage_execution_checkpoint consensus_capella_payload_paired_state consensus_capella_signed_transition consensus_capella_clock_diagnostics consensus_capella_published_signed_inventory consensus_capella_publication_cancel_boundary consensus_local_monotonic_time consensus_capella_duty_projection_availability consensus_isolated_stopped_capture_guards)
file(READ "${REGISTRY}" registry)
string(JSON count LENGTH "${registry}" tests)
list(LENGTH expected expected_count)
if(NOT count EQUAL expected_count)
 message(FATAL_ERROR "Core CTest count differs from reviewed selection")
endif()
math(EXPR last "${count}-1")
set(actual)
foreach(i RANGE 0 ${last})
 string(JSON name GET "${registry}" tests ${i} name)
 list(APPEND actual "${name}")
 string(JSON command_count LENGTH "${registry}" tests ${i} command)
 if(command_count LESS 1)
  message(FATAL_ERROR "Core CTest command missing: ${name}")
 endif()
 string(JSON executable GET "${registry}" tests ${i} command 0)
 if(NOT EXISTS "${executable}" OR IS_DIRECTORY "${executable}")
  message(FATAL_ERROR "Core CTest executable missing: ${name}")
 endif()
 string(JSON property_count LENGTH "${registry}" tests ${i} properties)
 set(properties)
 set(timeout "")
 set(label "")
 set(label_count 0)
 set(working_directory "")
 if(property_count GREATER 0)
  math(EXPR property_last "${property_count}-1")
  foreach(p RANGE 0 ${property_last})
   string(JSON property GET "${registry}" tests ${i} properties ${p} name)
   if(property IN_LIST properties)
    message(FATAL_ERROR "Core CTest duplicate property: ${name}/${property}")
   endif()
   list(APPEND properties "${property}")
   if(property STREQUAL "DISABLED" OR property STREQUAL "SKIP_RETURN_CODE" OR property STREQUAL "SKIP_REGULAR_EXPRESSION" OR property STREQUAL "WILL_FAIL" OR property STREQUAL "PASS_REGULAR_EXPRESSION")
    message(FATAL_ERROR "Core CTest skip property forbidden: ${name}/${property}")
   endif()
   if(property STREQUAL "TIMEOUT")
    string(JSON kind TYPE "${registry}" tests ${i} properties ${p} value)
    string(JSON timeout GET "${registry}" tests ${i} properties ${p} value)
    if(NOT kind STREQUAL "NUMBER" OR NOT timeout MATCHES "^[0-9]+(\\.[0-9]+)?$" OR timeout LESS_EQUAL 0)
     message(FATAL_ERROR "Core CTest timeout invalid: ${name}")
    endif()
   elseif(property STREQUAL "WORKING_DIRECTORY")
    string(JSON kind TYPE "${registry}" tests ${i} properties ${p} value)
    if(NOT kind STREQUAL "STRING")
     message(FATAL_ERROR "Core CTest working directory invalid: ${name}")
    endif()
    string(JSON working_directory GET "${registry}" tests ${i} properties ${p} value)
   elseif(property STREQUAL "LABELS")
    string(JSON label_count LENGTH "${registry}" tests ${i} properties ${p} value)
    if(label_count EQUAL 1)
     string(JSON label GET "${registry}" tests ${i} properties ${p} value 0)
    endif()
   endif()
  endforeach()
 endif()
 if(timeout STREQUAL "")
  message(FATAL_ERROR "Core CTest explicit timeout missing: ${name}")
 endif()
 if(name STREQUAL "consensus_capella_duty_projection_availability")
  if(NOT command_count EQUAL 2)
   message(FATAL_ERROR "Duty availability self-test command differs")
  endif()
  string(JSON argument GET "${registry}" tests ${i} command 1)
  get_filename_component(program_name "${executable}" NAME)
  if(NOT program_name STREQUAL "nano-capella-duty-availability-tests" OR NOT argument STREQUAL "--self-test" OR NOT timeout EQUAL 70 OR NOT label_count EQUAL 1 OR NOT label STREQUAL "qualification_consensus_duty_availability")
   message(FATAL_ERROR "Duty availability self-test command, label or budget differs")
  endif()
 endif()
 if(name STREQUAL "consensus_isolated_stopped_capture_guards")
  if(NOT command_count EQUAL 2)
   message(FATAL_ERROR "Isolated capture self-test command differs")
  endif()
  string(JSON argument GET "${registry}" tests ${i} command 1)
  get_filename_component(program_name "${executable}" NAME)
  if(NOT program_name STREQUAL "nano-capella-isolated-stopped-capture" OR NOT argument STREQUAL "--self-test" OR NOT timeout EQUAL 15 OR NOT label_count EQUAL 1 OR NOT label STREQUAL "qualification_consensus_recovery_tooling")
   message(FATAL_ERROR "Isolated capture self-test command, label or budget differs")
  endif()
 endif()
 if(name STREQUAL "rpc_simulation_context")
  if(NOT command_count EQUAL 2)
   message(FATAL_ERROR "RPC simulation context self-test command differs")
  endif()
  string(JSON argument GET "${registry}" tests ${i} command 1)
  get_filename_component(program_name "${executable}" NAME)
  if(NOT program_name STREQUAL "nano-rpc-simulation-context-tests" OR NOT argument STREQUAL "--simulation-context-self-test" OR NOT timeout EQUAL 90 OR NOT label_count EQUAL 1 OR NOT label STREQUAL "qualification_rpc_simulation_context")
   message(FATAL_ERROR "RPC simulation context self-test command, label or budget differs")
  endif()
 endif()
 # Bind the four newly selected RPC registrations, including legacy's fixture cwd.
 if(name STREQUAL "rpc")
  get_filename_component(program_name "${executable}" NAME)
  if(NOT command_count EQUAL 1 OR NOT program_name STREQUAL "nano-rpc-tests" OR NOT timeout EQUAL 120 OR NOT IS_ABSOLUTE "${working_directory}" OR NOT IS_DIRECTORY "${working_directory}" OR NOT EXISTS "${working_directory}/tests/fixtures/python-rpc.json")
   message(FATAL_ERROR "Legacy RPC command, fixture working directory or budget differs")
  endif()
 endif()
 set(state_program "")
 if(name STREQUAL "rpc_state_block_id")
  set(state_program "nano-rpc-state-block-id-tests")
  set(state_argument "--state-readers-self-test")
  set(state_label "qualification_rpc_state_block_id")
 elseif(name STREQUAL "rpc_get_proof")
  set(state_program "nano-rpc-get-proof-tests")
  set(state_argument "--get-proof-self-test")
  set(state_label "qualification_rpc_state_proof")
 elseif(name STREQUAL "rpc_state_read_cost")
  set(state_program "nano-rpc-state-read-cost-tests")
  set(state_argument "--state-read-cost-self-test")
  set(state_label "qualification_rpc_state_proof")
 endif()
 if(NOT state_program STREQUAL "")
  if(NOT command_count EQUAL 2)
   message(FATAL_ERROR "RPC state read/proof self-test command differs")
  endif()
  string(JSON argument GET "${registry}" tests ${i} command 1)
  get_filename_component(program_name "${executable}" NAME)
  if(NOT program_name STREQUAL state_program OR NOT argument STREQUAL state_argument OR NOT timeout EQUAL 90 OR NOT label_count EQUAL 1 OR NOT label STREQUAL state_label)
   message(FATAL_ERROR "RPC state read/proof self-test command, label or budget differs")
  endif()
 endif()
endforeach()
list(SORT actual)
list(SORT expected)
if(NOT actual STREQUAL expected)
 message(FATAL_ERROR "Core CTest names differ from reviewed selection")
endif()
message(STATUS "Verified ${count} daily core CTest registrations; full qualification not claimed")
